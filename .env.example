# Copy this file to .env and adjust for your environment.
# 10.0.2.2 is the Android emulator's alias for the host machine — swap it for
# your host's LAN IP if you're running on a physical device instead.

KEYCLOAK_ISSUER=http://10.0.2.2:8081/realms/library
KEYCLOAK_CLIENT_ID=library-flutter
KEYCLOAK_REDIRECT_URL=com.example.library1:/oauthredirect
API_BASE_URL=http://10.0.2.2:5281/api
